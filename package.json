{
  "name": "skillbridge-ai-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Client",
    "Server"
  ],
  "scripts": {
    "build": "npm run build --workspace=skillbridge-ai",
    "start": "npm start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=skillbridge-ai\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
