# SkillBridge AI Environment Variables Template
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Google OAuth Credentials
# Retrieve these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration (for OTP verification)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
